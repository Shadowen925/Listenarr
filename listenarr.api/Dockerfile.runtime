# Build gosu with a modern Go toolchain to avoid golang/stdlib CVEs present in
# the Debian-packaged version (compiled with Go 1.19.x).
FROM golang:1.26.2-alpine AS gosu-builder
ARG GOSU_VERSION=1.19
RUN CGO_ENABLED=0 go install github.com/tianon/gosu@${GOSU_VERSION}

FROM --platform=$TARGETPLATFORM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS discord-bot-dependencies
ARG TARGETARCH
WORKDIR /build/discord-bot
COPY tools/discord-bot/package.json tools/discord-bot/package-lock.json ./
RUN case "${TARGETARCH}:$(node -p 'process.arch')" in \
	amd64:x64|arm64:arm64) ;; \
	*) echo "ERROR: Node architecture does not match Docker target ${TARGETARCH}." >&2; exit 1 ;; \
	esac \
	&& npm ci --omit=dev --no-audit --no-fund \
	&& find node_modules -type f -name "*.map" -delete \
	&& npm cache clean --force

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 4545

# Set the URL to Listenarr's default port.
ENV ASPNETCORE_URLS=http://*:4545

ENV DOCKER_ENV=true
COPY docker/runtime/ /tmp/listenarr-runtime/

# Use the gosu binary built above instead of the apt package.
COPY --from=gosu-builder /go/bin/gosu /usr/local/bin/gosu
RUN chmod +x /usr/local/bin/gosu

RUN sh /tmp/listenarr-runtime/create-listenarr-user.sh

# Copy the Docker-specific publish output produced by the CI pipeline.
# Release ZIP artifacts are published under listenarr.api/publish and must not
# be copied into the runtime image.
ARG TARGETARCH
COPY listenarr.api/docker-publish/${TARGETARCH}/ /app/

RUN sh /tmp/listenarr-runtime/finalize-app.sh

# Explicitly copy the Discord bot source so it is available even if a local
# publish skipped optional tool copying.
COPY tools/discord-bot/ /app/tools/discord-bot/

# Copy only the Node runtime and production dependencies; npm remains in the
# build stage and is not included in the final image.
COPY --from=discord-bot-dependencies /usr/local/bin/node /usr/local/bin/node
COPY --from=discord-bot-dependencies /build/discord-bot/node_modules /app/tools/discord-bot/node_modules
RUN sh /tmp/listenarr-runtime/install-discord-bot-runtime.sh

# Return to app root
WORKDIR /app

# Copy entrypoint script for PUID/PGID/UMASK support
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN sh /tmp/listenarr-runtime/prepare-entrypoint.sh \
	&& rm -rf /tmp/listenarr-runtime

ENTRYPOINT ["/docker-entrypoint.sh"]
